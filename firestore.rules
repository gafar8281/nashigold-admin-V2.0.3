rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Owned and fully managed by this admin console.
    match /nashigold-employee-data/{employeeId} {
      allow read, write: if request.auth != null;
    }

    match /nashigold-announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }

    match /nashigold_branches/{branchId} {
      allow read, write: if request.auth != null;
    }

    // Created by the separate employee-facing app; this console only reviews.
    match /nashigold_leave_request/{requestId} {
      allow read: if request.auth != null;

      // Admin review path only — status + the three review fields, nothing else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'adminComment']);

      // TODO(coordinate before deploying): the employee app's auth model is
      // unknown, and it may also need to edit/cancel its own pending
      // requests. Confirm with that team, then tighten — do not guess.
      allow create: if true;
      allow delete: if false;

      // TODO(coordinate): this app's `branch` field is written by the
      // separate employee-facing app and is not validated against
      // nashigold_branches. Deleting a branch in this console does not
      // notify that app or block its submissions against the deleted code.
    }

    // Created by the separate employee-facing app; this console reads and deletes.
    match /nashigold_complaints/{complaintId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null;

      // TODO(coordinate before deploying): the employee app's auth model is
      // unknown. Leave create permissive until confirmed, then tighten — do
      // not guess.
      allow create: if true;
      allow update: if false;
    }

    // admin accounts are provisioned out-of-band (Firebase console / manual
    // seed) — this console only ever reads those to validate login.
    // secondary_admin accounts are created/edited/deleted from the "Add
    // Users" section (src/features/users), so writes are opened for that
    // role only, below.
    //
    // TODO(security gap, not coordination): documents here may carry
    // role: "admin" | "secondary_admin", managedBranches: string[], and
    // (for secondary_admin) a nested permissions object. That role/branch/
    // permission scoping is enforced ONLY client-side (see
    // src/lib/permissions.ts) — there is no way to check it here, because
    // the only Firebase Auth identity this app creates is an anonymous one
    // (see ensureAnonymousSession in src/lib/firebase.ts), so
    // `request.auth` carries no role or branch claims to key a rule on.
    // Real enforcement requires migrating to per-user Firebase Auth with
    // custom claims for role/managedBranches/permissions, then rewriting
    // every rule below to check them. Note that even then, `attendance`
    // (below) could not be branch-scoped without the employee-facing app
    // first denormalizing a `branch` field onto its records — today it
    // only carries `employeeId`.
    //
    // TODO(security gap, introduced by Add Users): opening create/update/
    // delete below to any anonymous session (the only identity this app
    // has) means anyone holding the public Firebase config can create or
    // delete secondary_admin accounts directly against Firestore, not just
    // through this console's UI. That is strictly worse than the previous
    // `allow write: if false`, and is the price of a client-side Add Users
    // section with no per-user Firebase Auth — admin documents remain
    // untouchable by any client, which bounds the damage to secondary_admin
    // accounts only. The real fix is the custom-claims migration above.
    match /nashigold_users/{userId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.role == 'secondary_admin';

      allow delete: if request.auth != null
        && resource.data.role == 'secondary_admin';
    }

    // This console is READ-ONLY against attendance — it is owned by a
    // separate employee-facing app.
    match /attendance/{recordId} {
      allow read: if request.auth != null;

      // TODO(coordinate before deploying): we do not know the auth model
      // used by the separate employee-facing app that WRITES this
      // collection. Tightening this could break that app. Leave writes
      // permissive until confirmed, then lock down explicitly — do not
      // guess and restrict this blind.
      allow write: if true;
    }

    // Owned by the separate employee-facing app; this console only clears
    // active_device_session so a locked-out employee can sign in elsewhere.
    match /user_session_data/{employeeId} {
      allow read: if request.auth != null;

      // Admin session-reset path only — that one field, nothing else.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['active_device_session']);

      // TODO(coordinate before deploying): the employee app's auth model is
      // unknown and it writes this collection on every sign-in. Leave create
      // permissive until confirmed, then tighten — do not guess.
      allow create: if true;
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
